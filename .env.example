# Copy this file to .env and fill in what you need. Only used by the local
# Python path (`uv run python main.py`) - Docker users set these in
# docker-compose.yml's `environment:` block instead. Every value below is
# optional; leaving a variable unset (or leaving this file uncopied) gives
# you the same defaults as running with nothing configured at all.

# Shared password gating the entire app (login page + every action). Unset
# = no login screen at all. Recommended if this instance is reachable by
# anyone other than you.
# APP_PASSWORD=

# Set to true only if you're running behind Docker/a remote server and need
# the manual "copy the OAuth URL from logs" sign-in flow instead of an
# auto-opened browser tab. Leave unset for local/desktop use.
# WEB_AUTH=false

# Custom hostname for the OAuth redirect URI - only needed for a custom
# domain or remote-server setup. See the README's Advanced Configuration
# section for the full walkthrough.
# OAUTH_HOST=localhost

# External port for the OAuth callback, if you're mapping Docker ports to
# something other than 8767 (e.g. "18767:8767" -> OAUTH_EXTERNAL_PORT=18767).
# OAUTH_EXTERNAL_PORT=

# Debug aid: logs a timestamped line for every Gmail API call the quota
# tracker charges. Off by default - only useful if you're diagnosing scan
# pacing/rate-limiting yourself.
# QUOTA_TRACE_LOGGING=false
